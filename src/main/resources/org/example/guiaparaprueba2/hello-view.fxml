<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<HBox spacing="20.0" alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.guiaparaprueba2.controller.CartasPokemonController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
    <VBox spacing="15.0">
        <Label text="VENTA DE CARTAS" styleClass="h3, text-primary, b"/>
        <Label text="Categoria: " GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="comboCategoria" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Ingrese el nombre de la carta: " GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="campoNombreCarta" promptText="Ej: Chamander Holo" styleClass="form-control"
                   GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Label text="Año: " GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    </VBox>

    <Label fx:id="welcomeText"/>
    <Button text="Hello!" onAction="#onBotonRegistrarClick"/>
</HBox>
